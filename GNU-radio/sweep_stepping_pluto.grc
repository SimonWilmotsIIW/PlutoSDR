connections:
- [analog_sig_source_x_0, '0', blocks_throttle2_0, '0']
- [analog_sig_source_x_0_0, '0', blocks_message_strobe_0_0, set_msg]
- [analog_sig_source_x_0_0, '0', qtgui_freq_sink_x_0, '0']
- [analog_sig_source_x_0_0, '0', qtgui_waterfall_sink_x_0, '0']
- [blocks_message_strobe_0_0, strobe, blocks_message_debug_0, print]
- [blocks_message_strobe_0_0, strobe, iio_attr_sink_0, attr]
- [blocks_throttle2_0, '0', probSign, '0']

metadata:
  file_format: 1
  grc_version: 3.10.11.0
